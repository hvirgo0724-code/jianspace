APP_ENV=development
DATABASE_URL=sqlite:///./data/jianspace.db
STORAGE_ROOT=./data/assets
APP_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:8000
COOKIE_SECURE=false
TASK_BACKEND=database
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro
# Optional ordered backups, same region and API key; at most 2 distinct backups.
# Example: DASHSCOPE_IMAGE_FALLBACK_MODELS=qwen-image-2.0,qwen-image-2.0-pro-2026-06-22
DASHSCOPE_IMAGE_FALLBACK_MODELS=
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
# Optional: text model for 小筑 via the OpenAI-compatible endpoint. Leave empty for rules only.
# Example: DASHSCOPE_TEXT_MODEL=qwen3.8-27b
DASHSCOPE_TEXT_MODEL=
# 小筑 weather lookup uses Open-Meteo without a key. Leave the city empty to ask the user.
WEATHER_ENABLED=true
WEATHER_DEFAULT_CITY=
# Override only when proxying Open-Meteo through your own gateway.
WEATHER_API_BASE=https://api.open-meteo.com
WEATHER_GEOCODING_BASE=https://geocoding-api.open-meteo.com
WEATHER_TIMEOUT_SECONDS=8
# Optional: support inbox for human handoff tickets. SMTP must also be configured.
SUPPORT_EMAIL=
# One optional visual structure check after image generation; provider token fees apply.
AI_STRUCTURE_REVIEW_ENABLED=false
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com
# Beijing: https://dashscope.aliyuncs.com
# Singapore: https://dashscope-intl.aliyuncs.com (requires a Singapore API key)
# A workspace API Host from the console can replace the legacy host above.
ALLOW_AI_CALLS=false
AI_IMAGE_CREDITS=10
AI_INPAINT_CREDITS=8
AI_PLAN_CREDITS=5
AI_DAILY_LIMIT=30
ALLOW_SELF_REGISTER=true
# One-time application grants; these are not cash or provider credits.
REGISTRATION_CREDITS=6
FAMILY_TRIAL_CREDITS=30
FAMILY_TRIAL_DAYS=14

# SMTP for email verification and human handoff tickets.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public URL used in verification and share links.
PUBLIC_URL=http://127.0.0.1:5180

# Plan recognition backend: dashscope (cloud vision) or yolov8 (local GPU).
LOCAL_RECOGNITION_BACKEND=dashscope
LOCAL_INFERENCE_DEVICE=cuda
# Path to a floor-plan YOLOv8 checkpoint; class names must include wall/door/window/room.
YOLOV8_WEIGHTS=yolov8n-floorplan.pt

# Optional ControlNet adapter (requires torch + diffusers + transformers + accelerate).
CONTROLNET_MODEL=diffusers/controlnet-canny-sdxl-1.0
CONTROLNET_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
CONTROLNET_STEPS=28
CONTROLNET_SEED=20260101
