# Docker Compose 部署配置示例。
# 构建期依赖镜像源；中国大陆网络建议保留，海外部署可改回官方源。
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 方式一：运行 scripts/docker-deploy.ps1（Windows）或 scripts/docker-deploy.sh（Linux/macOS），
#         脚本会复制本文件为 .env.docker 并生成随机数据库密码。
# 方式二：手动复制为 .env.docker，修改下面的值后执行：
#         docker compose --env-file .env.docker up -d --build

# 本机一键体验：APP_ENV=development，允许 HTTP 并使用体验账户。
# 对外部署：APP_ENV=production、PUBLIC_URL=https://你的域名、COOKIE_SECURE=true，
#          并由反向代理提供 TLS；生产模式不开放演示账户。
APP_ENV=development
PUBLIC_URL=http://127.0.0.1:8080
COOKIE_SECURE=false

# 必填：数据库密码，请改成长随机字符串；脚本会自动生成。
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# 百炼 AI：不填 Key 时只有规则知识库、布局与导出可用。
ALLOW_AI_CALLS=true
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro
DASHSCOPE_IMAGE_FALLBACK_MODELS=qwen-image-2.0
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_TEXT_MODEL=qwen3.8-27b
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com
AI_IMAGE_CREDITS=10
AI_INPAINT_CREDITS=8
AI_PLAN_CREDITS=5
AI_DAILY_LIMIT=30
AI_STRUCTURE_REVIEW_ENABLED=true

# 小筑天气：Open-Meteo 免费接口，无需密钥。
WEATHER_ENABLED=true
WEATHER_DEFAULT_CITY=上海

# 账户与试用：生产环境不开放演示账户，注册后在账户页领取家庭版试用积分。
ALLOW_SELF_REGISTER=true
REGISTRATION_CREDITS=6
FAMILY_TRIAL_CREDITS=30
FAMILY_TRIAL_DAYS=14

# 可选：转人工工单通知邮箱，需要同时配置 SMTP。
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 可选：对象存储；默认使用本地卷 asset_data。
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
