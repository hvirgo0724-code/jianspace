{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interior-studio:scene:1.0",
  "title": "Interior Studio Scene 1.0",
  "description": "结构化场景快照。Schema校验不替代几何、跨引用、状态与权限校验。坐标和尺寸为mm，货币为整数分。当前业务支持最多两个楼层；家具 Z 为本层相对高度，elevationMm 为楼层标高；可选 stairs 表示连接楼层的直跑参考楼梯。structureHash仅覆盖服务端规范化后的schemaVersion、unit、coordinateSystem和floors结构字段，排除sceneId、geometryVersionId、measurements、confirmation与layout。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sceneId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "geometryVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "unit": {
      "const": "mm"
    },
    "coordinateSystem": {
      "const": "RIGHT_HANDED_Z_UP"
    },
    "floors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/floor"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    }
  },
  "required": [
    "schemaVersion",
    "sceneId",
    "geometryVersionId",
    "unit",
    "coordinateSystem",
    "floors",
    "measurements",
    "confirmation",
    "layout"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "coordinate": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "lengthMm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "point2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "point3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "size3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "floor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "elevationMm": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/room"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wall"
          },
          "minItems": 1,
          "maxItems": 2000
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "obstacles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obstacle"
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "stairs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/stair"
          }
        }
      },
      "required": ["id", "name", "elevationMm", "rooms", "walls", "openings", "obstacles"],
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "living",
            "bedroom",
            "courtyard",
            "terrace",
            "garage",
            "stairwell",
            "kitchen",
            "bathroom",
            "dining",
            "study",
            "balcony",
            "hall",
            "storage",
            "other"
          ]
        },
        "boundaryMm": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 200
        },
        "heightMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "computedAreaMm2": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000000
        },
        "wallRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "wallId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "side": {
                "enum": ["left", "right"]
              }
            },
            "required": ["wallId", "side"],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 200
        }
      },
      "required": ["id", "name", "type", "boundaryMm", "heightMm", "computedAreaMm2", "wallRefs"],
      "additionalProperties": false
    },
    "wall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "startMm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "endMm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "thicknessMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "heightMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "structuralRole": {
          "enum": ["unknown", "documented_load_bearing", "documented_non_load_bearing"]
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": ["id", "startMm", "endMm", "thicknessMm", "heightMm", "structuralRole", "locked"],
      "additionalProperties": false
    },
    "opening": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": ["door", "window", "passage"]
        },
        "wallId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "offsetMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "widthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "bottomMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "heightMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "connects": {
          "type": "array",
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "model": {
          "enum": ["hinged", "archway", "casement", "panoramic", "floor-to-ceiling"]
        },
        "swing": {
          "$ref": "#/$defs/swing"
        }
      },
      "required": [
        "id",
        "kind",
        "wallId",
        "offsetMm",
        "widthMm",
        "bottomMm",
        "heightMm",
        "connects"
      ],
      "additionalProperties": false
    },
    "swing": {
      "type": "object",
      "properties": {
        "hinge": {
          "enum": ["start", "end"]
        },
        "direction": {
          "enum": ["cw", "ccw"]
        },
        "angleDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": ["hinge", "direction", "angleDeg", "roomId"],
      "additionalProperties": false
    },
    "obstacle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": ["column", "beam", "fixed_equipment", "protected_zone", "planter"]
        },
        "polygonMm": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 200
        },
        "baseZMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "heightMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "locked": {
          "const": true
        }
      },
      "required": ["id", "kind", "polygonMm", "baseZMm", "heightMm", "locked"],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "floorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "targetType": {
          "enum": ["room", "wall", "opening", "obstacle"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "measurementType": {
          "enum": [
            "width",
            "depth",
            "height",
            "thickness",
            "offset",
            "bottom",
            "diagonal",
            "edge_length"
          ]
        },
        "rawValue": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        },
        "rawUnit": {
          "enum": ["mm", "cm", "m"]
        },
        "normalizedMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "method": {
          "enum": ["laser", "tape", "drawing", "user_estimate", "other"]
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceAssetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "maxItems": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "floorId",
        "targetType",
        "targetId",
        "measurementType",
        "rawValue",
        "rawUnit",
        "normalizedMm",
        "method",
        "measuredAt",
        "sourceAssetIds",
        "notes"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "basis": {
          "enum": ["user_measured", "demo"]
        },
        "status": {
          "enum": ["draft", "validating", "needs_review", "confirmed", "superseded", "archived"]
        },
        "confirmedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurementRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["status", "measurementRevision"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["confirmedBy", "confirmedAt"],
            "properties": {
              "confirmedBy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "confirmedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "furniture": {
      "type": "object",
