    "catalog": {
      "type": "object",
      "properties": {
        "skuId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sizeMm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "priceMinor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "enum": ["CNY"]
