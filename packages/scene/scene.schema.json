          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "planSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetId", "method", "referenceWidthMm", "unverifiedDimensions"],
          "properties": {
            "assetId": { "type": "string", "minLength": 1, "maxLength": 100 },
            "method": { "const": "vision-draft" },
            "referenceWidthMm": { "type": "integer", "minimum": 2000, "maximum": 100000 },
            "unverifiedDimensions": { "const": true }
          }
        },
        "furniture": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/furniture"
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "exterior": {
          "type": "object",
          "properties": { "styleId": { "enum": ["modern", "nordic", "mediterranean", "chinese"] } },
          "required": ["styleId"],
          "additionalProperties": false
        },
        "cameraViews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/camera"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "catalogSnapshot": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "minItems": 0,
          "maxItems": 2000
        },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "occupants": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "children": {
              "type": "boolean"
            },
            "elderly": {
              "type": "boolean"
            },
            "storagePriority": {
              "type": "boolean"
            },
            "passageMm": {
              "type": "integer",
              "minimum": 400,
              "maximum": 1500
            },
            "budgetMinor": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 100000000000
            }
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "score": {
              "type": "number"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 20
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            }
          }
        },
        "renovation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wastePercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "contingencyPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "rooms": {
              "type": "array",
              "maxItems": 400,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["roomId", "enabled"],
                "properties": {
                  "roomId": {
                    "$ref": "#/$defs/id"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "floorMaterialMinor": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 100000000000
                  },
                  "floorLaborMinor": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 100000000000
                  },
                  "wallMaterialMinor": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 100000000000
                  },
                  "wallLaborMinor": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 100000000000
                  },
                  "ceilingMaterialMinor": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 100000000000
                  },
                  "ceilingLaborMinor": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 100000000000
                  }
                }
              }
            },
            "extraLines": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "category", "quantity", "unit", "unitPriceMinor"],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "roomId": {
                    "type": ["string", "null"]
                  },
                  "category": {
                    "enum": ["material", "labor", "electrical", "plumbing", "other"]
                  },
                  "quantity": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 1000000
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "unitPriceMinor": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 100000000000
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "id",
        "name",
        "styleId",
        "furniture",
        "materials",
        "cameraViews",
        "catalogSnapshot"
      ],
      "additionalProperties": false
    },
    "stair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startMm", "endMm", "widthMm", "targetFloorId", "stepCount"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "startMm": {
          "$ref": "#/$defs/point2"
        },
        "endMm": {
          "$ref": "#/$defs/point2"
        },
        "widthMm": {
          "type": "integer",
          "minimum": 600,
          "maximum": 3000
        },
        "targetFloorId": {
          "$ref": "#/$defs/id"
        },
        "stepCount": {
          "type": "integer",
          "minimum": 3,
          "maximum": 40
        }
      }
    }
  }
}
