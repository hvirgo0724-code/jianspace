            }
          ]
        },
        "positionMm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "sizeMm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "rotationDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "floorId",
        "roomId",
        "skuId",
        "positionMm",
        "sizeMm",
        "rotationDeg",
        "locked"
      ],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "targetType": {
          "enum": ["room_floor", "room_ceiling", "wall_surface"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "materialId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": ["targetType", "targetId", "materialId"],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "floorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "positionMm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "targetMm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "fovDeg": {
          "type": "number",
          "minimum": 10,
